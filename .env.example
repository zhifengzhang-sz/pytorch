# Copy to .env (gitignored). docker compose reads it automatically.
#
# Host user id/group id so files created in the bind-mounted workspace are
# owned by you, not root. Check with `id -u` and `id -g`. 1000 is the first
# user on most Linux distros. On Docker Desktop (macOS/Windows) ownership is
# mapped automatically and these values do not matter.
UID=1000
GID=1000

# Optional: pin PyTorch for reproducible builds (empty = latest cu128 wheel).
TORCH_VERSION=
